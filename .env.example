# 本地复制为 .env；GitHub Actions 使用同名 Secrets，勿提交真实密钥。
CHANNELS=email
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=your-account@163.com
SMTP_PASSWORD=your-smtp-authorization-code
EMAIL_FROM=your-account@163.com
EMAIL_TO=your-account@163.com
PUSHPLUS_TOKEN=
# 可选；Actions 自动提供 GITHUB_TOKEN
GITHUB_TOKEN=
CONFIG_PATH=config.json
STATE_PATH=state/delivery.json
REPORT_DIR=reports

# --- 微信公众号草稿箱（只能本地跑，见 news_digest/wechat.py 顶部说明） ---
# 公众号后台 → 开发 → 基本配置，拿 AppID / AppSecret，并把本机出口 IP 加进 IP 白名单。
# 千万别把这两项配到 GitHub Secrets —— Actions 的动态 IP 过不了白名单，配了也只会报 40164。
WECHAT_APPID=
WECHAT_SECRET=
# 可选：当日新闻没有配图时用作封面的本地图片路径（草稿封面为必填项）
WECHAT_COVER=
# 可选：正文「阅读原文」跳转地址（通常填日报线上版链接）
WECHAT_SOURCE_URL=
# 可选：文章作者署名
WECHAT_AUTHOR=
