{
  "name": "ai-news-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  // Cron Triggers 使用 UTC。北京时间 = UTC + 8。
  // 17 分触发是刻意的：避开整点/半点的调度高峰。
  // 签到用 23:17-23:47 每分钟触发，由 Worker 内的日期哈希
  // 选定当天实际派发分钟，实现 0-30 分钟随机延迟（见 src/index.js）。
  "triggers": {
    "crons": ["17 0 * * *", "17-47 23 * * *"]
  },
  "vars": {
    "GITHUB_REPO": "dcgitcode/ai-news-daily"
  }
}
